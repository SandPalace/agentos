#!/usr/bin/env bash
# Comando `agentos`: start | stop | status | update | whatsapp
set -uo pipefail

# Resuelve la ruta real del repo aunque se llame por un symlink.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  D="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$D/$SELF" ;; esac
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

AGENTOS_HOME="${AGENTOS_HOME:-$HOME/.agentos}"
PORT="${AGENTOS_PORT:-4780}"
WEB_PORT="${AGENTOS_WEB_PORT:-4781}"
RUN="$AGENTOS_HOME/run"; LOGS="$AGENTOS_HOME/logs"
SERVER_JS="$REPO/plugins/agentos-core/server/src/server.mjs"
NEXT_BIN="$REPO/web/node_modules/next/dist/bin/next"
export AGENTOS_PORT="$PORT" AGENTOS_HOME

say() { printf '%s\n' "$*"; }
healthy() { curl -fsS -m 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; }
web_up()  { curl -fsS -m 3 -o /dev/null "http://127.0.0.1:$WEB_PORT/" 2>/dev/null; }
port_pid() { command -v lsof >/dev/null 2>&1 && lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null | head -1; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
pidof_file() { [ -f "$1" ] && cat "$1" 2>/dev/null; }

open_url() {
  [ "${AGENTOS_NO_OPEN:-}" = 1 ] && return 0
  if command -v open >/dev/null 2>&1; then open "$1" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

cmd_start() {
  mkdir -p "$RUN" "$LOGS"
  if [ ! -d "$REPO/web/.next" ]; then say "Falta compilar la web. Corre ./install.sh primero."; exit 1; fi
  if healthy; then say "Servidor ya estaba corriendo (puerto $PORT)."
  else
    if [ -n "$(port_pid "$PORT")" ]; then say "El puerto $PORT está ocupado por otro programa. Ciérralo o usa AGENTOS_PORT=otro-puerto agentos start."; exit 1; fi
    nohup node "$SERVER_JS" >>"$LOGS/server.log" 2>&1 </dev/null &
    echo $! >"$RUN/server.pid"; disown 2>/dev/null || true
    for _ in $(seq 1 40); do healthy && break; sleep 0.25; done
    healthy || { say "El servidor no arrancó. Revisa $LOGS/server.log"; exit 1; }
    say "Servidor iniciado (puerto $PORT)."
  fi
  if web_up; then say "Oficina web ya estaba corriendo (puerto $WEB_PORT)."
  else
    if [ -n "$(port_pid "$WEB_PORT")" ]; then say "El puerto $WEB_PORT está ocupado por otro programa. Usa AGENTOS_WEB_PORT=otro-puerto agentos start."; exit 1; fi
    (cd "$REPO/web" && nohup node "$NEXT_BIN" start -p "$WEB_PORT" -H 127.0.0.1 >>"$LOGS/web.log" 2>&1 </dev/null & echo $! >"$RUN/web.pid")
    for _ in $(seq 1 80); do web_up && break; sleep 0.25; done
    web_up || { say "La web no arrancó. Revisa $LOGS/web.log"; exit 1; }
    say "Oficina web iniciada (puerto $WEB_PORT)."
  fi
  say "Abre: http://localhost:$WEB_PORT"
  open_url "http://localhost:$WEB_PORT"
}

stop_one() { # nombre pidfile puerto
  local pid pp stopped=0; pid="$(pidof_file "$2")"; pp="$(port_pid "$3")"
  for x in $pid $pp; do alive "$x" && kill "$x" 2>/dev/null && stopped=1; done
  for _ in 1 2 3 4 5 6 7 8; do [ -z "$(port_pid "$3")" ] && break; sleep 0.25; done
  [ "$stopped" = 1 ] && say "$1 detenido." || say "$1 no estaba corriendo."
  rm -f "$2"
}
cmd_stop() { stop_one "Oficina web" "$RUN/web.pid" "$WEB_PORT"; stop_one "Servidor" "$RUN/server.pid" "$PORT"; }

wa_port() { local u="${AGENTOS_WA_URL:-$(env_get AGENTOS_WA_URL)}"; u="${u:-http://127.0.0.1:8002}"; u="${u##*:}"; u="${u%%/*}"; case "$u" in ''|*[!0-9]*) echo 8002 ;; *) echo "$u" ;; esac; }

cmd_status() {
  healthy && say "Servidor:      corriendo (puerto $PORT)" || say "Servidor:      detenido"
  web_up  && say "Oficina web:   corriendo -> http://localhost:$WEB_PORT" || say "Oficina web:   detenida"
  local wp wh; wp="$(wa_port)"; wh="$(curl -fsS -m 2 "http://127.0.0.1:$wp/health" 2>/dev/null || true)"
  if [ -z "$wh" ]; then say "WhatsApp:      detenido (opcional: agentos whatsapp)"
  elif printf '%s' "$wh" | grep -q '"connected":true'; then say "WhatsApp:      conectado (puerto $wp)"
  else say "WhatsApp:      corriendo, esperando que escanees el QR (puerto $wp)"; fi
  say "Repo: $REPO"
}

# ---------- WhatsApp (opcional, no oficial) ----------
WA_VERSION="5.6.2"   # @open-wa/wa-automate fijado: el CLI cambia rápido entre versiones
env_get() { [ -f "$AGENTOS_HOME/.env" ] && grep -E "^$1=" "$AGENTOS_HOME/.env" | tail -1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//"; }
rand_hex() { node -e 'process.stdout.write(require("crypto").randomBytes(24).toString("hex"))'; }

wa_ensure_env() {
  mkdir -p "$AGENTOS_HOME"
  local f="$AGENTOS_HOME/.env"
  [ -f "$f" ] || { ( umask 077; : >"$f" ); }
  chmod 600 "$f" 2>/dev/null || true
  [ -n "$(tail -c1 "$f" 2>/dev/null)" ] && printf '\n' >>"$f"
  [ -n "$(env_get AGENTOS_WA_URL)" ]            || printf 'AGENTOS_WA_URL=http://127.0.0.1:8002\n' >>"$f"
  [ -n "$(env_get AGENTOS_WA_API_KEY)" ]        || printf 'AGENTOS_WA_API_KEY=%s\n' "$(rand_hex)" >>"$f"
  [ -n "$(env_get AGENTOS_WA_WEBHOOK_SECRET)" ] || printf 'AGENTOS_WA_WEBHOOK_SECRET=%s\n' "$(rand_hex)" >>"$f"
  chmod 600 "$f" 2>/dev/null || true
}

wa_notice() {
  cat <<'TXT'

=====================  AVISO IMPORTANTE: WHATSAPP  =====================
Esto usa una herramienta NO OFICIAL (open-wa) que controla WhatsApp Web.
WhatsApp no la autoriza: tu número PUEDE SER BLOQUEADO.
  - Usa un número de prueba o un WhatsApp Business secundario, NO tu número principal.
  - Responde solo a personas que te escribieron primero. Nada de envíos masivos.
  - Los mensajes llegan a AgentOS; el agente solo prepara borradores y TÚ los envías.
  - Todo corre en tu computadora (127.0.0.1); nada se expone a internet.
========================================================================
TXT
}

cmd_whatsapp() {
  local wa_home="$AGENTOS_HOME/whatsapp" accepted="$AGENTOS_HOME/whatsapp-accepted"
  if [ "${1:-}" = "--reset" ]; then
    printf 'Esto borra la sesión de WhatsApp guardada en %s y tendrás que escanear el QR otra vez.\n¿Continuar? (si/no): ' "$wa_home"
    local a; read -r a
    case "$a" in si|SI|Si|sí|Sí) rm -rf "$wa_home"; say "Sesión borrada.";; *) say "Cancelado.";; esac
    return 0
  fi
  command -v node >/dev/null 2>&1 || { say "No encuentro Node.js."; exit 1; }
  command -v npx  >/dev/null 2>&1 || { say "No encuentro npx (viene con Node.js)."; exit 1; }
  wa_ensure_env
  if [ ! -f "$accepted" ]; then
    wa_notice
    printf '\nEscribe «acepto» para continuar: '
    local a; read -r a
    case "$(printf '%s' "$a" | tr 'A-Z' 'a-z')" in acepto) date -u +%Y-%m-%dT%H:%M:%SZ >"$accepted" ;; *) say "No se aceptó. No se inició WhatsApp."; exit 1 ;; esac
  fi
  local url key secret wp
  url="$(env_get AGENTOS_WA_URL)"; key="$(env_get AGENTOS_WA_API_KEY)"; secret="$(env_get AGENTOS_WA_WEBHOOK_SECRET)"
  export AGENTOS_WA_URL="${url:-http://127.0.0.1:8002}"; wp="$(wa_port)"
  healthy || say "Aviso: el servidor AgentOS no está corriendo. Abre otra terminal y corre: agentos start"
  if [ -n "$(port_pid "$wp")" ]; then say "El puerto $wp ya está en uso (¿WhatsApp ya está corriendo?)."; exit 1; fi
  mkdir -p "$wa_home"; chmod 700 "$wa_home" 2>/dev/null || true
  cat <<TXT

En tu teléfono abre WhatsApp > Dispositivos vinculados > Vincular dispositivo
y escanea el código QR que aparecerá aquí abajo (puede tardar un minuto).
Deja esta ventana abierta. Para detener WhatsApp: Ctrl+C.

TXT
  AGENTOS_WA_API_KEY="$key" AGENTOS_WA_WEBHOOK_SECRET="$secret" node "$REPO/scripts/whatsapp-bridge.mjs" &
  local bridge=$!
  trap 'kill "$bridge" 2>/dev/null' EXIT
  trap 'exit 130' INT TERM
  ( cd "$wa_home" && WA_API_KEY="$key" WA_SESSION_DATA_PATH="$wa_home" \
      npx -y "@open-wa/wa-automate@$WA_VERSION" --session-id agentos --host 127.0.0.1 --port "$wp" --no-dashboard )
}

cmd_update() {
  cd "$REPO" || exit 1
  say "Actualizando AgentOS..."
  git pull --ff-only || { say "No se pudo hacer git pull. Revisa tu conexión o avisa a tu instructor."; exit 1; }
  local was_web=0; web_up && was_web=1
  cmd_stop
  (cd web && npm ci --no-audit --no-fund && NEXT_PUBLIC_AGENTOS_PORT="$PORT" node node_modules/next/dist/bin/next build) || { say "Falló la compilación."; exit 1; }
  if command -v claude >/dev/null 2>&1 && [ "${AGENTOS_SKIP_CLAUDE:-}" != 1 ]; then
    claude plugin marketplace update agentos || true
    for p in agentos-core marketing-team sales-team; do claude plugin update "$p@agentos" || true; done
  fi
  say "Listo. Reinicia tus sesiones de Claude para cargar los cambios."
  [ "$was_web" = 1 ] && cmd_start
}

case "${1:-}" in
  start) cmd_start ;; stop) cmd_stop ;; status) cmd_status ;; update) cmd_update ;;
  whatsapp) shift; cmd_whatsapp "$@" ;;
  *) say "Uso: agentos {start|stop|status|update|whatsapp [--reset]}"; exit 2 ;;
esac
