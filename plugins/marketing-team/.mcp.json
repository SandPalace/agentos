{
  "mcpServers": {
    "meta-ads": {
      "type": "http",
      "url": "https://mcp.facebook.com/ads"
    },
    "meta-browser": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        "${HOME}/.agentos/browser/meta",
        "--output-dir",
        "${HOME}/.agentos/browser/meta-output",
        "--viewport-size",
        "1440,900"
      ]
    }
  }
}
